{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "TSF_EVAL_PACK_V1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "packId", "version", "category", "cases"],
  "properties": {
    "schemaVersion": { "const": "TSF_EVAL_PACK_V1" },
    "packId": { "type": "string" },
    "version": { "type": "integer", "minimum": 1 },
    "category": {
      "type": "string",
      "enum": ["PLANNER", "WORKER", "VERIFIER", "ROUTING", "MEMORY", "AUTONOMY", "ESTIMATOR"]
    },
    "description": { "type": "string" },
    "cases": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "description", "assertions"],
        "properties": {
          "id": { "type": "string" },
          "description": { "type": "string" },
          "input": {},
          "tags": { "type": "array", "items": { "type": "string" } },
          "assertions": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "additionalProperties": true,
              "required": ["type", "path"],
              "properties": {
                "type": {
                  "type": "string",
                  "enum": ["EQUALS", "CONTAINS", "NOT_CONTAINS", "MATCHES", "GTE", "LTE"]
                },
                "path": { "type": "string" }
              }
            }
          }
        }
      }
    }
  }
}
