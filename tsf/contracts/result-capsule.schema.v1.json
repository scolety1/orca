{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://tsf.local/contracts/result-capsule.schema.v1.json",
  "title": "TSF Result Capsule V1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "missionId",
    "workerIdentity",
    "outcome",
    "repository",
    "filesChanged",
    "testsRun",
    "evidence",
    "blockers",
    "unresolvedQuestions",
    "implementationSummary",
    "recommendedNextStep"
  ],
  "properties": {
    "schemaVersion": { "const": "TSF_RESULT_CAPSULE_V1" },
    "missionId": { "type": "string", "minLength": 1, "maxLength": 160 },
    "workerIdentity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["role", "providerId", "agentId", "orcaSessionId", "worktreeId"],
      "properties": {
        "role": { "type": "string", "minLength": 1 },
        "providerId": { "type": "string", "minLength": 1 },
        "agentId": { "type": "string", "minLength": 1 },
        "modelObserved": { "type": ["string", "null"] },
        "orcaSessionId": { "type": "string", "minLength": 1 },
        "providerConversationId": { "type": ["string", "null"] },
        "worktreeId": { "type": "string", "minLength": 1 }
      }
    },
    "outcome": { "enum": ["SUCCEEDED", "FAILED", "BLOCKED", "NEEDS_INPUT", "PARTIAL"] },
    "repository": {
      "type": "object",
      "additionalProperties": false,
      "required": ["head", "tree"],
      "properties": {
        "head": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
        "tree": { "type": "string", "pattern": "^[0-9a-f]{40}$" }
      }
    },
    "filesChanged": { "type": "array", "items": { "type": "string" }, "maxItems": 2048 },
    "testsRun": { "type": "array", "items": { "type": "object" }, "maxItems": 256 },
    "evidence": { "type": "array", "items": { "type": "object" }, "minItems": 1, "maxItems": 512 },
    "blockers": { "type": "array", "items": { "type": "string" }, "maxItems": 128 },
    "unresolvedQuestions": { "type": "array", "items": { "type": "string" }, "maxItems": 128 },
    "implementationSummary": { "type": "string", "minLength": 1, "maxLength": 8192 },
    "recommendedNextStep": { "type": "string", "minLength": 1, "maxLength": 4096 }
  }
}
