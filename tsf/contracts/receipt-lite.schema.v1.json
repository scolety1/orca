{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://tsf.local/contracts/receipt-lite.schema.v1.json",
  "title": "TSF Receipt Lite V1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "kind",
    "projectId",
    "missionId",
    "orca",
    "execution",
    "result",
    "tests",
    "decision",
    "identities",
    "previousReceiptHash",
    "timestamp",
    "receiptHash"
  ],
  "properties": {
    "schemaVersion": { "const": "TSF_RECEIPT_LITE_V1" },
    "kind": { "enum": ["MISSION_CREATED", "CANDIDATE_FINISHED", "VERIFIER_RESULT", "ADOPTION_DECISION", "RELEASE_PROMOTION", "HUMAN_CONSEQUENTIAL_APPROVAL"] },
    "projectId": { "type": "string", "minLength": 1 },
    "missionId": { "type": "string", "minLength": 1 },
    "orca": { "type": "object" },
    "execution": { "type": "object" },
    "result": {},
    "tests": { "type": "array" },
    "decision": {},
    "identities": { "type": "object" },
    "previousReceiptHash": { "type": ["string", "null"], "pattern": "^[0-9a-f]{64}$" },
    "timestamp": { "type": "string", "format": "date-time" },
    "receiptHash": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
  }
}
