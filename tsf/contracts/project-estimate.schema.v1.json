{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://tsf.local/contracts/project-estimate.schema.v1.json",
  "title": "TSF Project Estimate V1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "projectId", "wbs", "generatedAt"],
  "properties": {
    "schemaVersion": { "const": "TSF_PROJECT_ESTIMATE_V1" },
    "projectId": { "type": "string", "minLength": 1 },
    "wbs": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/wbsTask" }
    },
    "generatedAt": { "type": "string" }
  },
  "$defs": {
    "threePoint": {
      "type": "object",
      "additionalProperties": false,
      "required": ["min", "expected", "max"],
      "properties": {
        "min": { "type": "number", "minimum": 0 },
        "expected": { "type": "number", "minimum": 0 },
        "max": { "type": "number", "minimum": 0 }
      }
    },
    "wbsTask": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "title", "activeEffortHours"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "title": { "type": "string", "minLength": 1 },
        "stage": { "type": ["string", "null"] },
        "category": { "type": ["string", "null"] },
        "dependencies": {
          "type": "array",
          "items": { "type": "string" },
          "description": "Task ids this task depends on. Not used by the wave-2 estimation engine (a flat, independent-task sum) -- reserved for the dependency-aware Delivery Planner wave."
        },
        "conflictsWith": {
          "type": "array",
          "items": { "type": "string" },
          "description": "Task ids sharing a likely file/component conflict. Same reservation as dependencies."
        },
        "activeEffortHours": { "$ref": "#/$defs/threePoint" },
        "humanReviewHours": { "$ref": "#/$defs/threePoint" },
        "externalWaitHours": { "$ref": "#/$defs/threePoint" },
        "clarity": {
          "type": "number",
          "minimum": 0,
          "maximum": 1,
          "default": 0.7,
          "description": "How well understood the task is (0 = unknown unknowns, 1 = fully scoped). Widens the effective range when low -- distinct from confidence."
        },
        "confidence": {
          "type": "number",
          "minimum": 0,
          "maximum": 1,
          "default": 0.7,
          "description": "How much the estimator trusts the given min/expected/max numbers themselves. Widens the effective range when low -- distinct from clarity."
        },
        "risk": { "enum": ["LOW", "MODERATE", "HIGH", null], "default": null },
        "providerRoleHint": {
          "enum": [
            "PLANNER_DEEP",
            "PLANNER_BALANCED",
            "WORKER_CHEAP",
            "WORKER_BALANCED",
            "WORKER_DEEP",
            "VERIFIER_INDEPENDENT",
            null
          ],
          "default": null,
          "description": "References tsf/domain/routing.mjs's own TSF_EXECUTION_ROLES vocabulary -- never a second role taxonomy."
        },
        "assumptions": { "type": "array", "items": { "type": "string" } },
        "evidence": { "type": "array", "items": { "type": "string" } },
        "blockers": { "type": "array", "items": { "type": "string" } },
        "directCostItems": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["label", "amountUsd"],
            "properties": {
              "label": { "type": "string", "minLength": 1 },
              "amountUsd": { "type": "number", "minimum": 0 }
            }
          }
        }
      }
    }
  }
}
